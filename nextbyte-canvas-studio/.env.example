# Skopiuj do .env.local i uzupełnij. Plik .env.local NIE jest częścią eksportu (klucze nigdy nie trafiają do repozytorium ani do bundla przeglądarki).

# Runware — generacja obrazu (Nano Banana Lite / 2 / Pro, GPT Image 2). https://runware.ai
RUNWARE_API_KEY=

# Google Gemini — reżyser (analiza zdjęć i pinesek), rozpoznawanie obiektów i osób, kontrola wyniku. https://aistudio.google.com/apikey
GEMINI_API_KEY=
